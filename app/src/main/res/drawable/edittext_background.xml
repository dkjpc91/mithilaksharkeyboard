<!-- res/drawable/edittext_background.xml -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Rounded corners -->
    <corners android:radius="16dp" />

    <!-- Gradient background -->
    <gradient
        android:startColor="#E3F2FD"
    android:endColor="#BBDEFB"
    android:angle="45" />

    <!-- Stroke (border) -->
    <stroke
        android:width="1dp"
        android:color="#90CAF9"
    />

    <!-- Padding -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />
</shape>