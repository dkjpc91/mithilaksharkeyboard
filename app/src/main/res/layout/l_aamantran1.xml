<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/bg"
    android:background="@drawable/page9"
    android:padding="2dp"
    android:gravity="center">

    <!-- RelativeLayout as the first child -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="4dp"
        android:gravity="center">

        <!-- ImageView for the main occasion image -->
        <ImageView
            android:id="@+id/image1"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:src="@drawable/m"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="10dp"
            android:contentDescription="मुख्य आयोजन छवि"
            android:layout_marginTop="0dp" />

        <!-- LinearLayout for the additional text messages -->
        <LinearLayout
            android:id="@+id/textContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/image1"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="2dp"
            android:background="#00FBFBFB"
            android:orientation="vertical"
            android:padding="8dp"
            android:gravity="center">

            <!-- TextView for the main heading -->
            <TextView
                android:padding="2dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:id="@+id/txt1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="प्रियजन, हम अहाँकेँ सादर आमंत्रण दैत छी कि अहाँ अपन परिवार संग आबि [आयोजनक नाम] मे भाग लिअऽ। अहाँक उपस्थिति सँ एहिठामक आनंद आ उत्साह आरो बढ़त।"
                android:textSize="16sp"
                android:textColor="@color/red"
                android:textStyle="bold"
                android:layout_marginTop="1dp"
                android:layout_marginBottom="1dp" /> <!-- 1dp bottom margin -->

            <!-- TextView for the event date -->
            <TextView
                android:id="@+id/txt2"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="2dp"
                android:text="📅 तारीख: [तारीख जोड़ू]"
                android:textColor="@color/green"
                android:textSize="16sp" />

            <!-- TextView for the event location -->
            <TextView
                android:id="@+id/txt3"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:text="📍 स्थान: [स्थान जोड़ू]"
                android:textColor="@color/green"
                android:textSize="16sp" />

            <!-- TextView for the event time -->
            <TextView
                android:id="@+id/txt4"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:text="⏰ समय: [समय जोड़ू]"
                android:textColor="@color/green"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txt5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="अहाँक आगमन केर प्रतीक्षा मे।\nसादर,\n[अहाँक नाम] 🙏✨"
            android:textSize="20sp"
            android:textColor="@color/red"
            android:textStyle="bold"
            android:layout_below="@id/textContainer"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:gravity="center" />

        <!-- Second ImageView for the event celebration -->
        <ImageView
            android:id="@+id/image2"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_below="@id/txt5"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="-5dp"
            android:contentDescription="आयोजन उत्सव"
            android:scaleType="fitCenter"
            android:src="@drawable/m" />
    </RelativeLayout>
</LinearLayout>