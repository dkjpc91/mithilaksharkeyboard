<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/bg"
    android:background="@drawable/page4"
    android:padding="2dp">

    <!-- RelativeLayout as the first child -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp">

        <!-- ImageView for Durga Maa idol -->
        <ImageView
            android:id="@+id/image1"
            android:layout_marginTop="95dp"
            android:layout_width="240dp"
            android:layout_height="250dp"
            android:src="@drawable/m"

            android:layout_centerHorizontal="true"
            android:contentDescription="Durga Maa Idol" />



        <!-- LinearLayout for the additional text messages -->
        <LinearLayout
            android:id="@+id/textContainer"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/image1"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="3dp"
            android:background="#00FBFBFB"
            android:orientation="vertical"
            android:padding="2dp">

            <!-- TextView for the main greeting -->
            <TextView
                android:padding="2dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:id="@+id/txt1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="शुभ दुर्गा पूजा!"
                android:textSize="30sp"
                android:textColor="@color/yellow"
                android:textStyle="bold"
                android:layout_below="@id/image1"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="4dp" />

            <!-- TextView for the first message -->
            <TextView
                android:id="@+id/txt2"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:text="दुर्गा पूजा भक्ति, शक्ति आ उत्साह केर पर्व छी। ई पूजा माँ दुर्गा के विजय आ बुराई प असत्य प विजय के प्रतीक छी।"
                android:textColor="@color/yellow"
                android:textSize="16sp" />

            <!-- TextView for the second message -->
            <TextView
                android:id="@+id/txt3"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:text="ई पूजा मे भक्त लोग माँ दुर्गा के आशीर्वाद लेबे आ अपन जीवन मे सुख, शांति आ समृद्धि के कामना करैत छथि।"
                android:textColor="@color/yellow"
                android:textSize="16sp" />

            <!-- TextView for the third message -->
            <TextView

                android:id="@+id/txt4"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:text="सभके दुर्गा पूजा के हार्दिक शुभकामना! माँ दुर्गा हमर जीवन मे खुशी आ शांति ले आवन।"
                android:textColor="@color/yellow"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- Signature TextView inside RelativeLayout -->
        <TextView
            android:id="@+id/txt5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Name"
            android:textSize="24sp"
            android:textColor="@color/yellow"
            android:textStyle="bold"
            android:layout_below="@id/textContainer"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="2dp"
            android:gravity="center"/>

        <!-- ImageView for Durga Puja celebration -->
        <ImageView
            android:id="@+id/image2"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_below="@id/txt5"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="2dp"
            android:contentDescription="Durga Puja Celebration"
            android:scaleType="fitCenter"
            android:src="@drawable/m" />
    </RelativeLayout>
</LinearLayout>