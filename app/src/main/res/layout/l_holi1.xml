<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/bg"
    android:background="@drawable/page10"
    android:padding="10dp">

    <!-- RelativeLayout as the first child -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp">

        <!-- ImageView for the Diwali lamp -->
        <ImageView
            android:id="@+id/image1"
            android:layout_marginTop="15dp"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@drawable/share"
            android:layout_centerHorizontal="true"
            android:contentDescription="Diwali Lamp" />

        <!-- TextView for the main greeting -->
        <TextView
            android:padding="5dp"
            android:gravity="center"
            android:id="@+id/txt1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="शुभ दीपावली!"
            android:textSize="32sp"
            android:textColor="@color/red"
            android:textStyle="bold"
            android:layout_below="@id/image1"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="6dp" />

        <!-- LinearLayout for the additional text messages -->
        <LinearLayout
            android:id="@+id/textContainer"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/txt1"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="8dp"
            android:background="#00FBFBFB"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- TextView for the first message -->
            <TextView
                android:id="@+id/txt2"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="मिथिला मे होली केँ ‘फगुआ’ कहल जाइत अछि। ई पाबैन रंग आ उमंग केर संग भक्ति आ संस्कृतिक प्रतीक छी।"
                android:textColor="@color/blue"
                android:textSize="18sp" />

            <!-- TextView for the second message -->
            <TextView
                android:id="@+id/txt3"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="मिथिला मे होली केवल रंगक खेल नहि, बल्कि भजन-कीर्तन, सामूहिक नाच-गान आ पारंपरिक लोकगीत केर माध्यम सँ मनाओल जाइत अछि।"
                android:textColor="@color/blue"
                android:textSize="18sp" />

            <!-- TextView for the third message -->
            <TextView
                android:id="@+id/txt4"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="सभके होली के हार्दिक शुभकामना! रंग आ खुशी से भरल होली मनाउ।"
                android:textColor="@color/blue"
                android:textSize="18sp" />

        </LinearLayout>

        <!-- Signature TextView inside RelativeLayout -->
        <TextView
            android:id="@+id/txt5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Name"
            android:textSize="24sp"
            android:textColor="@color/red"
            android:textStyle="bold"
            android:layout_below="@id/textContainer"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="05dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"/>

        <!-- ImageView for the festival crackers -->
        <ImageView
            android:id="@+id/image2"
            android:layout_width="300dp"
            android:layout_height="200dp"
            android:layout_below="@id/txt5"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="2dp"
            android:contentDescription="Festival Crackers"
            android:scaleType="centerCrop"
            android:src="@drawable/zigzag" />
    </RelativeLayout>
</LinearLayout>